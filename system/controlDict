FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     Flint_multiphaseEulerFoamD;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

//endTime         2.001e-3;
endTime         1.001e-3;

deltaT          1.0e-8;

writeControl    adjustableRunTime;

writeInterval   1e-05;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

writeInitial  yes;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           3.0;
maxAlphaCo      3.0;
//maxCo           0.25;
//maxAlphaCo      0.3;

maxDeltaT       5e-7;

functions
{
  T_slice
  {
    type            surfaces;
    libs            ("libsampling.so");

    // run/write frequently
    executeControl  runTime;
    executeInterval 1e-6;
    writeControl    runTime;
    writeInterval   1e-6;

    fields          (T);
    interpolationScheme cellPoint;
    surfaceFormat   vtk;

    surfaces
    (
      // z = 0.001 plane
      planeZ001
      {
        type        plane;
        planeType   pointAndNormal;
        pointAndNormalDict
        {
          basePoint     (0 0 0.001);
          normalVector  (0 0 1);
        }
        interpolate  false;
        triangulate  false;
      }

      // y = 0 plane
      planeY0
      {
        type        plane;
        planeType   pointAndNormal;
        pointAndNormalDict
        {
          basePoint     (0 0 0);     // any point with y = 0
          normalVector  (0 1 0);     // normal along +y
        }
        interpolate  false;          // set true if you want smoother values
        triangulate  false;
      }
    );
  }
}

