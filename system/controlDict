FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     Flint_multiphaseEulerFoamD;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

//endTime         0.83e-3;
endTime         1.001e-7;

deltaT          1.0e-8;

writeControl    adjustableRunTime;

writeInterval   1e-07;

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

writeInitial  yes;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

//maxCo           10.0;
//maxAlphaCo      10.0;
maxCo           0.25;
maxAlphaCo      0.3;

maxDeltaT       1e-7;


// ************************************************************************* //
