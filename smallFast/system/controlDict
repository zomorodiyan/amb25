FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     smallFast;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         73.01e-3;

deltaT          1.0e-8;

writeControl    adjustableRunTime;

//writeInterval   1e-05;
writeInterval   1e10;
writeFieldsOnly (T);

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression uncompressed;

writeInitial  yes;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           3.0; //0.25;
maxAlphaCo      3.0; //0.3;

maxDeltaT       1e-6;

functions
{
  T_slice
  {
    type            surfaces;
    libs            ("libsampling.so");

    // run/write frequently
    executeControl  runTime;
    executeInterval 1e-5;
    writeControl    runTime;
    writeInterval   1e-5;

    fields          (T);
    interpolationScheme cellPoint;
    surfaceFormat   vtk;

    surfaces
    (
      // z = 0.00025 plane
      planeZ00025
      {
        type        plane;
        planeType   pointAndNormal;
        pointAndNormalDict
        {
          basePoint     (0 0 0.00025);
          normalVector  (0 0 1);
        }
        interpolate  true;
        triangulate  false;
      }

      // z = 0.0005 plane
      planeZ0005
      {
        type        plane;
        planeType   pointAndNormal;
        pointAndNormalDict
        {
          basePoint     (0 0 0.0005);
          normalVector  (0 0 1);
        }
        interpolate  true;
        triangulate  false;
      }

      // y = 0 plane
      planeY0
      {
        type        plane;
        planeType   pointAndNormal;
        pointAndNormalDict
        {
          basePoint     (0 0 0);     // any point with y = 0
          normalVector  (0 1 0);     // normal along +y
        }
        interpolate  true;           // set true if you want smoother values
        triangulate  false;
      }
    );
  }

  T_only
  {
    type            writeObjects;
    libs            ("libutilityFunctionObjects.so");
    writeControl    runTime;
    writeInterval   1e-3;
    fields          (T);
  }
};

